# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 运行时数据（全部忽略，运行时自动生成）
cache/*
data/*
!data/.gitkeep

# 工作区（运行时沙箱文件，不进入版本控制）
workspaces/*

# 插件（独立 git 仓库，不作为项目一部分）
plugins/*
!plugins/__init__.py

# 配置文件（含 API 密钥，勿提交）
config/

# 代码审查产物（应由审查工具自行管理，不进入版本控制）
docs/chat-*.md

# 自动生成的锁文件
skills-lock.json


# 参考/工具目录（不进入版本控制）
# 参考/工具/技能目录（不进入版本控制）
libs/
.agents/
.claude/
.pi-subagents/

# agent run plan
/docs/
