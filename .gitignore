# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 附件 & 表情缓存
cache/*
data/attachments/*
data/emojis/*
!data/attachments/.gitkeep
!data/emojis/.gitkeep

# 会话历史缓存
data/sessions/*

# 工作区（运行时沙箱文件，不进入版本控制）
workspaces/*

# 插件（独立 git 仓库，不作为项目一部分）
plugins/*
!plugins/__init__.py

